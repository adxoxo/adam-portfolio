{
	// Cloudflare Workers config for the Qwik Router app (official Cloudflare
	// Workers adapter). Committing this stops `wrangler deploy` from running its
	// non-interactive auto-config. `npm run build` (qwik build) writes the client
	// files and dist/_worker.js; the Worker reads the static files through the
	// ASSETS binding (the adapter middleware calls env.ASSETS.fetch).
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "adam-portfolio",
	// Browser-safe config, committed so `wrangler deploy` cannot strip it.
	// The anon key is public by design; RLS is the real guard. Server code reads
	// these per request from the Worker env (never inlined into the client
	// bundle). SUPABASE_SERVICE_ROLE_KEY + any tokens/webhooks stay dashboard
	// SECRETS (never committed).
	"vars": {
		"PUBLIC_SUPABASE_URL": "https://vldogzagemaatnzszhiu.supabase.co",
		"PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZsZG9nemFnZW1hYXRuenN6aGl1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQwNDg3NzMsImV4cCI6MjA5OTYyNDc3M30.awmVTTEdGEs56u53v3OC0VobpYS35YRvPsjivTcerMM",
		"PUBLIC_GITHUB_USER": "adxoxo"
	},
	// Newest date the pinned wrangler 4.110.0 runtime (workerd 1.20260708.1)
	// supports, so local `wrangler dev` and production run the same semantics.
	"compatibility_date": "2026-07-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"main": "./dist/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"build": {
		"command": "npm run build"
	},
	"observability": {
		"enabled": true
	}
}

# Runtime config for the Worker. Public values ship in wrangler.jsonc `vars`;
# secrets live in the Cloudflare dashboard. For local runs of the built Worker,
# put overrides in .dev.vars (wrangler dev reads it). With the Supabase values
# blank the site still runs: it renders the full public snapshot in
# src/lib/data/projects.ts, the admin explains the missing config, and
# /api/sync-repos returns a dry run.

# Supabase (public: the anon key is safe to expose; RLS is the guard)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role (server only, NEVER exposed). Used by /api/sync-repos
# to write archive drafts. When set, only the signed-in owner may sync.
SUPABASE_SERVICE_ROLE_KEY=

# Confirmed admin identity (server only). Set this as a Worker secret so a
# valid Supabase session for any other account cannot access or edit /admin.
OWNER_EMAIL=

# Which GitHub account the archive syncs from
PUBLIC_GITHUB_USER=adxoxo

# Optional GitHub token (server only) to raise the sync rate limit
GITHUB_TOKEN=

# n8n webhook that receives a new lead (server only). /api/lead also stores the
# lead in the Supabase `leads` table when Supabase is configured. With neither
# target, /api/lead answers 503 with an email fallback; nothing is logged.
N8N_LEAD_WEBHOOK=

# n8n webhook that receives a "schedule a call" request (server only). Blank =
# /api/schedule answers 503 with the Calendly and email fallbacks; nothing is
# logged. A non-2xx webhook answer is a 502, never a success.
N8N_SCHEDULE_WEBHOOK=
